<odoo>
    <record id="view_project_form_inherit_deviz" model="ir.ui.view">
        <field name="name">project.project.form.deviz</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Deviz">
                    <group>
                        <field name="estimate_line_ids">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="unit_price"/>
                                <field name="subtotal"/>
                                <field name="deviz_category_id"/>
                            </tree>
                        </field>
                    </group>
                    <separator string="Sumar deviz" colspan="2"/>
                    <group>
                        <field name="devise_summary" readonly="1" widget="html"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>