<odoo>
    <!-- Vedere Tree -->
    <record id="view_ticket_report_devise_tree" model="ir.ui.view">
        <field name="name">ticket.report.devise.tree</field>
        <field name="model">ticket.report.devise</field>
        <field name="arch" type="xml">
            <tree string="Raport Tichete">
                <field name="ticket_id"/>
                <field name="ticket_name"/>
                <field name="ticket_subject"/>
                <field name="customer_name"/>
                <field name="project_name"/>
                <field name="stage"/>
                <field name="task_name"/>
                <field name="tip_document"/>
                <field name="numar_intern"/>
                <field name="date_deadline"/>
                <field name="ticket_billed"/>
                <field name="total_hours"/>
                <field name="cost_manopera"/>
                <field name="venit_manopera"/>
                <field name="total_material_qty"/>
                <field name="cost_material"/>
                <field name="venit_material"/>
                <field name="total_transport_qty"/>
                <field name="cost_transport"/>
                <field name="venit_transport"/>
                <field name="so_amount"/>
                <field name="so_tax"/>
                <field name="so_total"/>
                <field name="so_count"/>
            </tree>
        </field>
    </record>

    <!-- Vedere Pivot -->
    <record id="view_ticket_report_devise_pivot" model="ir.ui.view">
        <field name="name">ticket.report.devise.pivot</field>
        <field name="model">ticket.report.devise</field>
        <field name="arch" type="xml">
            <pivot string="Pivot Raport Tichete">
                <field name="ticket_id"/>
                <field name="customer_name"/>
                <field name="project_name"/>
                <field name="stage"/>
                <field name="total_hours" type="measure"/>
                <field name="cost_manopera" type="measure"/>
                <field name="venit_manopera" type="measure"/>
                <field name="cost_material" type="measure"/>
                <field name="venit_material" type="measure"/>
                <field name="cost_transport" type="measure"/>
                <field name="venit_transport" type="measure"/>
                <field name="so_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vedere Graph -->
    <record id="view_ticket_report_devise_graph" model="ir.ui.view">
        <field name="name">ticket.report.devise.graph</field>
        <field name="model">ticket.report.devise</field>
        <field name="arch" type="xml">
            <graph string="Grafic Raport Tichete" type="bar">
                <field name="ticket_name" type="row"/>
                <field name="total_hours" type="measure"/>
                <field name="so_total" type="measure"/>
                <field name="cost_material" type="measure"/>
                <field name="venit_material" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Vedere Cautare -->
    <record id="view_tichete_dashboard_search" model="ir.ui.view">
        <field name="name">ticket.report.devise.search</field>
        <field name="model">ticket.report.devise</field>
        <field name="arch" type="xml">
            <search string="Cautare Tichete">
                <field name="ticket_id"/>
                <field name="ticket_name"/>
                <field name="customer_name"/>
                <field name="project_name"/>
                <field name="stage"/>
            </search>
        </field>
    </record>
</odoo>
