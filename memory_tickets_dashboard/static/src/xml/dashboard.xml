<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="memory_tickets_dashboard.TicheteDashboard">
    <div class="o_container">

      <h1 class="o_title">Deviz lucrări - Sinteză tichete</h1>

      <!-- Secțiunea Manoperă -->
      <h2>Manoperă</h2>
      <div class="o_row">
        <div class="o_col o_col_4">
          <div class="o_card"><strong>Ore lucrate:</strong> <t t-esc="state.total_ore"/> h</div>
        </div>
        <div class="o_col o_col_4">
          <div class="o_card"><strong>Cost manoperă:</strong> <t t-esc="state.cost_manopera"/> lei</div>
        </div>
        <div class="o_col o_col_4">
          <div class="o_card"><strong>Venit manoperă:</strong> <t t-esc="state.venit_manopera"/> lei</div>
        </div>
      </div>

      <!-- Secțiunea Materiale -->
      <h2>Materiale</h2>
      <div class="o_row">
        <div class="o_col o_col_4">
          <div class="o_card"><strong>Cost materiale fișă:</strong> <t t-esc="state.total_materiale_fisa"/> lei</div>
        </div>
        <div class="o_col o_col_4">
          <div class="o_card"><strong>Venit materiale fișă:</strong> <t t-esc="state.venit_materiale_fisa"/> lei</div>
        </div>
        <div class="o_col o_col_4">
          <div class="o_card"><strong>Cost materiale pick-uri:</strong> <t t-esc="state.total_materiale_pick"/> lei</div>
        </div>
      </div>
      <div class="o_row">
        <div class="o_col o_col_12">
          <div class="o_card"><strong>Discrepanță materiale:</strong> <t t-esc="state.discrepanta_materiale"/> lei</div>
        </div>
      </div>

      <!-- Secțiunea Transport -->
      <h2>Transport</h2>
      <div class="o_row">
        <div class="o_col o_col_6">
          <div class="o_card"><strong>Total km:</strong> <t t-esc="state.total_km"/> km</div>
        </div>
        <div class="o_col o_col_6">
          <div class="o_card"><strong>Cost transport:</strong> <t t-esc="state.cost_transport"/> lei</div>
        </div>
      </div>
      <div class="o_row">
        <div class="o_col o_col_12">
          <div class="o_card"><strong>Venit transport:</strong> <t t-esc="state.venit_transport"/> lei</div>
        </div>
      </div>

      <!-- Secțiunea Facturi -->
      <h2>Facturi și Profit</h2>
      <div class="o_row">
        <div class="o_col o_col_6">
          <div class="o_card"><strong>Venit total facturi:</strong> <t t-esc="state.venit_total_facturi"/> lei</div>
        </div>
        <div class="o_col o_col_6">
          <div class="o_card"><strong>Profit estimat:</strong> <t t-esc="state.profit_total"/> lei</div>
        </div>
      </div>

    </div>
  </t>
</templates>