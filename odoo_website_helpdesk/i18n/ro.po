#. module: odoo_website_helpdesk
#: model:mail.template,body_html:odoo_website_helpdesk.helpdesk_replay_email_template
msgid ""
"<div class=\"container\">\n"
"                <h4 style=\"text-align:center\">Helpdesk Replay</h4>\n"
"                <div style=\"min-height:30vh;\">mesaj........</div>\n"
"                <t t-set=\"base_url\" t-value=\"request.env['ir.config_parameter'].sudo().get_param('web.base.url')\"></t>\n"
"                <h6>\n"
"                    <a t-attf-href=\"{{base_url}}/my/tickets/{{object.id}}\" class=\"btn btn-primary\">Vizualizați Tichetul\n"
"                    </a>\n"
"                </h6>\n"
"                <table class=\"table table-light\" width=\"100%\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <th>Nume</th>\n"
"                            <td>\n"
"                                <t t-if=\"object.assigned_user_id\">\n"
"                                    <t t-esc=\"object.assigned_user_id.name\"></t>\n"
"                                </t>\n"
"                                <t t-else=\"\">nume utilizator</t>\n"
"                                <t t-esc=\"base_url\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <th>Nume echipă</th>\n"
"                            <td>\n"
"                                <t t-if=\"object.team_id\">\n"
"                                    <t t-esc=\"object.team_id.name\"></t>\n"
"                                </t>\n"
"                                <t t-else=\"\">Nume echipă</t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <th>Răspuns la</th>\n"
"                            <td>\n"
"                                <t t-set=\"date\" t-value=\"(datetime.date.today())\"></t>\n"
"                                <t t-esc=\"date\"></t>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""

